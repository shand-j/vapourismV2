{%- comment -%}
  NicPowch Footer Section
{%- endcomment -%}

{%- style -%}
  .footer {
    background-color: #111827;
    color: white;
    margin-top: auto;
  }

  .footer__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 750px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer__column-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: white;
  }

  .footer__column-text {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__link {
    display: block;
    padding: 0.375rem 0;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover {
    color: white;
  }

  .footer__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 2rem;
    text-align: center;
  }

  .footer__stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .footer__stat-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.25rem;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    text-align: center;
  }

  @media (min-width: 750px) {
    .footer__bottom {
      flex-direction: row;
      text-align: left;
    }
  }

  .footer__copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
    margin: 0;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__legal-link {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer__legal-link:hover {
    color: white;
  }

  /* Newsletter */
  .footer__newsletter {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.15) 0%, rgba(var(--color-secondary-rgb), 0.15) 100%);
    border-radius: var(--border-radius-large);
    padding: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 990px) {
    .footer__newsletter {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .footer__newsletter-content {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 990px) {
    .footer__newsletter-content {
      margin-bottom: 0;
      flex: 1;
    }
  }

  .footer__newsletter-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.5rem 0;
  }

  .footer__newsletter-desc {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .footer__newsletter-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (min-width: 750px) {
    .footer__newsletter-form {
      flex-wrap: nowrap;
    }
  }

  .footer__newsletter-input {
    flex: 1;
    min-width: 200px;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--border-radius);
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .footer__newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.15);
  }

  .footer__newsletter-btn {
    padding: 0.875rem 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .footer__newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(var(--color-primary-rgb), 0.4);
  }

  .footer__newsletter-success {
    color: var(--color-secondary);
    font-size: 0.875rem;
    display: none;
  }

  .footer__newsletter-form.submitted .footer__newsletter-success {
    display: block;
  }

  .footer__newsletter-form.submitted input,
  .footer__newsletter-form.submitted button {
    display: none;
  }

  /* Social Icons */
  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.7);
    transition: all 0.2s;
  }

  .footer__social-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
  }
{%- endstyle -%}

<footer class="footer" role="contentinfo">
  <div class="footer__container">
    {%- comment -%} Newsletter Section {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter">
        <div class="footer__newsletter-content">
          <h3 class="footer__newsletter-title">{{ section.settings.newsletter_title | default: 'Get 10% off your first order' }}</h3>
          <p class="footer__newsletter-desc">{{ section.settings.newsletter_description | default: 'Join our newsletter for exclusive deals and new product alerts.' }}</p>
        </div>
        {%- form 'customer', class: 'footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="footer__newsletter-input"
            placeholder="Enter your email"
            required
            autocomplete="email"
          >
          <button type="submit" class="footer__newsletter-btn">Subscribe</button>
          <p class="footer__newsletter-success">✓ Thanks for subscribing!</p>
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="footer__grid">
      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">{{ section.settings.brand_title | default: shop.name }}</h3>
        <p class="footer__column-text">{{ section.settings.brand_description | default: "UK's specialist nicotine pouch retailer. Premium tobacco-free pouches for a smoke-free lifestyle." }}</p>

        {%- comment -%} Social Links {%- endcomment -%}
        {%- if section.settings.show_social -%}
          <div class="footer__social">
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" class="footer__social-link" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" class="footer__social-link" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
              <a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener" class="footer__social-link" aria-label="Twitter/X">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" class="footer__social-link" aria-label="TikTok">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Shop Links {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Shop by Strength</h3>
        <ul class="footer__links">
          <li><a href="/collections/nicotine-pouches?filter.p.tag=3mg" class="footer__link">3mg - Light</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=6mg" class="footer__link">6mg - Medium</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=10mg" class="footer__link">10mg - Strong</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=20mg" class="footer__link">20mg - Maximum</a></li>
        </ul>
      </div>

      {%- comment -%} Brands {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Popular Brands</h3>
        <ul class="footer__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'brand_link' -%}
              <li><a href="{{ block.settings.url }}" class="footer__link">{{ block.settings.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <li><a href="/collections/velo" class="footer__link">Velo</a></li>
            <li><a href="/collections/killa" class="footer__link">Killa</a></li>
            <li><a href="/collections/nordic-spirit" class="footer__link">Nordic Spirit</a></li>
            <li><a href="/collections/on" class="footer__link">On!</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Customer Service {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Customer Service</h3>
        <ul class="footer__links">
          <li><a href="/pages/delivery-information" class="footer__link">Delivery Information</a></li>
          <li><a href="/pages/returns-policy" class="footer__link">Returns & Refunds</a></li>
          <li><a href="/pages/contact" class="footer__link">Contact Us</a></li>
          <li><a href="/pages/faq" class="footer__link">FAQ</a></li>
          <li><a href="/pages/age-verification" class="footer__link">Age Verification</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__stats">
      <div class="footer__stat">
        <div class="footer__stat-value">FREE</div>
        <div class="footer__stat-label">Delivery on orders over £30</div>
      </div>
      <div class="footer__stat">
        <div class="footer__stat-value" style="color: var(--color-secondary);">1pm</div>
        <div class="footer__stat-label">Same-day dispatch cutoff</div>
      </div>
      <div class="footer__stat">
        <div class="footer__stat-value" style="color: #06b6d4;">18+</div>
        <div class="footer__stat-label">Age verification required</div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/policies/terms-of-service" class="footer__legal-link">Terms</a>
        <span style="color: rgba(255,255,255,0.3);">•</span>
        <a href="/policies/privacy-policy" class="footer__legal-link">Privacy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "newsletter_description",
      "label": "Newsletter description",
      "default": "Join our newsletter for exclusive deals and new product alerts."
    },
    {
      "type": "header",
      "content": "Brand Info"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "NicPowch"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "UK's specialist nicotine pouch retailer. Premium tobacco-free pouches for a smoke-free lifestyle."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter/X URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "brand_link",
      "name": "Brand link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
