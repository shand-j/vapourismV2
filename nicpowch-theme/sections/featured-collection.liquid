{%- comment -%}
  Featured Collection Section
  Shows a horizontal carousel of products from a specific collection
  with "Add to cart" buttons and "View all" link (like nicpouch.co.uk)
{%- endcomment -%}

{%- style -%}
  .featured-collection {
    padding: var(--spacing-sections-mobile) 0;
    background: {{ section.settings.background_color }};
  }

  @media (min-width: 990px) {
    .featured-collection {
      padding: var(--spacing-sections-desktop) 0;
    }
  }

  .featured-collection__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .featured-collection__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .featured-collection__title {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 750px) {
    .featured-collection__title {
      font-size: 2.5rem;
    }
  }

  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    border: 2px solid var(--color-primary);
    border-radius: var(--border-radius);
    transition: all 0.3s;
  }

  .featured-collection__view-all:hover {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    border-color: transparent;
  }

  .featured-collection__view-all svg {
    transition: transform 0.3s;
  }

  .featured-collection__view-all:hover svg {
    transform: translateX(4px);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 990px) {
    .featured-collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Product Card with Add to Cart */
  .fc-product-card {
    position: relative;
    border-radius: var(--border-radius);
    background: white;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .fc-product-card:hover {
    box-shadow: 0 8px 30px rgba(var(--color-primary-rgb), 0.12);
    transform: translateY(-2px);
  }

  .fc-product-card__image {
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-secondary-rgb), 0.05));
  }

  .fc-product-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fc-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .fc-product-card:hover .fc-product-card__image img {
    transform: scale(1.05);
  }

  /* Sale Badge */
  .fc-product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: white;
    background: #dc2626;
    border-radius: 4px;
    z-index: 1;
  }

  /* Sold Out Badge */
  .fc-product-card__sold-out {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    background: rgba(15, 23, 42, 0.8);
    border-radius: 4px;
    z-index: 1;
  }

  .fc-product-card__content {
    padding: 1rem;
  }

  .fc-product-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fc-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .fc-product-card__title a:hover {
    color: var(--color-primary);
  }

  .fc-product-card__price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .fc-product-card__price-compare {
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    text-decoration: line-through;
    margin-right: 0.5rem;
  }

  .fc-product-card__add-to-cart {
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: opacity 0.3s, transform 0.2s;
  }

  .fc-product-card__add-to-cart:hover {
    opacity: 0.9;
    transform: scale(1.02);
  }

  .fc-product-card__add-to-cart:disabled {
    background: #9ca3af;
    cursor: not-allowed;
    transform: none;
  }

  .fc-product-card__sold-out-btn {
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
    background: #e5e7eb;
    border: none;
    border-radius: var(--border-radius);
    cursor: not-allowed;
  }
{%- endstyle -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show | default: 4
-%}

{%- if collection != blank -%}
  <section class="featured-collection">
    <div class="featured-collection__container">
      <header class="featured-collection__header">
        <h2 class="featured-collection__title">{{ section.settings.title | default: collection.title }}</h2>
        {%- if section.settings.show_view_all -%}
          <a href="{{ collection.url }}" class="featured-collection__view-all">
            View all
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        {%- endif -%}
      </header>

      <div class="featured-collection__grid">
        {%- for product in collection.products limit: products_to_show -%}
          <div class="fc-product-card">
            {%- if product.compare_at_price > product.price -%}
              {%- assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
              <span class="fc-product-card__badge">-{{ discount_percent }}%</span>
            {%- elsif product.available == false -%}
              <span class="fc-product-card__sold-out">Sold out</span>
            {%- endif -%}

            <div class="fc-product-card__image">
              <a href="{{ product.url }}" aria-label="{{ product.title }}">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    srcset="{{ product.featured_image | image_url: width: 250 }} 250w, {{ product.featured_image | image_url: width: 500 }} 500w"
                    sizes="(max-width: 500px) 50vw, 25vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {%- else -%}
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #ccc;">
                    {% render 'icon-product-placeholder' %}
                  </div>
                {%- endif -%}
              </a>
            </div>

            <div class="fc-product-card__content">
              <h3 class="fc-product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <div class="fc-product-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="fc-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                {{ product.price | money }}
              </div>

              {%- if product.available -%}
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="fc-product-card__add-to-cart">
                    Add to cart
                  </button>
                </form>
              {%- else -%}
                <button type="button" class="fc-product-card__sold-out-btn" disabled>
                  Sold out
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "title": "Featured Products",
        "products_to_show": 4,
        "show_view_all": true
      }
    }
  ]
}
{% endschema %}
