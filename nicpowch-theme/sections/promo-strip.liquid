{%- comment -%}
  Promo Strip Section
  Horizontal promotional banner with icons - like nicpouches.com USP strip
{%- endcomment -%}

{%- style -%}
  .promo-strip {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    padding: 0.875rem 0;
  }

  .promo-strip__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .promo-strip__grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 750px) {
    .promo-strip__grid {
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .promo-strip__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: white;
    text-decoration: none;
    transition: transform 0.2s, opacity 0.2s;
  }

  .promo-strip__item:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .promo-strip__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .promo-strip__icon svg {
    width: 1rem;
    height: 1rem;
  }

  .promo-strip__text {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 749px) {
    .promo-strip__item:nth-child(n+3) {
      display: none;
    }
  }
{%- endstyle -%}

<section class="promo-strip">
  <div class="promo-strip__container">
    <div class="promo-strip__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" class="promo-strip__item" {{ block.shopify_attributes }}>
          <span class="promo-strip__icon">
            {%- case block.settings.icon -%}
              {%- when 'points' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {%- when 'mix' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              {%- when 'deal' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'secure' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {%- endcase -%}
          </span>
          <span class="promo-strip__text">{{ block.settings.text }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Strip",
  "tag": "section",
  "class": "section-promo-strip",
  "settings": [],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "points", "label": "Points/Rewards" },
            { "value": "mix", "label": "Mix & Match" },
            { "value": "deal", "label": "Deals" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" }
          ],
          "default": "points"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Save with Points"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Strip",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "icon": "points",
            "text": "Save with Nic Points - Up to 8% off for life!"
          }
        },
        {
          "type": "promo",
          "settings": {
            "icon": "mix",
            "text": "Mix & Match - Buy in bulk & save more!"
          }
        },
        {
          "type": "promo",
          "settings": {
            "icon": "deal",
            "text": "Grab a deal - Top brands discounted!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
