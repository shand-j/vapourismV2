{%- comment -%}
  Collections with Products Section
  Shows all collections with product previews and "See more" links
  Matches nicpouch.co.uk /collections page style
{%- endcomment -%}

{%- style -%}
  .collections-products {
    padding: var(--spacing-sections-mobile) 0;
  }

  @media (min-width: 990px) {
    .collections-products {
      padding: var(--spacing-sections-desktop) 0;
    }
  }

  .collections-products__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collections-products__collection {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .collections-products__collection:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .collections-products__header {
    margin-bottom: 1.5rem;
  }

  .collections-products__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .collections-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 750px) {
    .collections-products__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 990px) {
    .collections-products__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Product Card */
  .cp-product-card {
    position: relative;
    border-radius: var(--border-radius);
    background: white;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .cp-product-card:hover {
    box-shadow: 0 8px 30px rgba(var(--color-primary-rgb), 0.12);
    transform: translateY(-2px);
  }

  .cp-product-card__image {
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-secondary-rgb), 0.05));
  }

  .cp-product-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cp-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .cp-product-card:hover .cp-product-card__image img {
    transform: scale(1.05);
  }

  /* Badges */
  .cp-product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: white;
    background: #dc2626;
    border-radius: 4px;
    z-index: 1;
  }

  .cp-product-card__sold-out-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    background: rgba(15, 23, 42, 0.8);
    border-radius: 4px;
    z-index: 1;
  }

  .cp-product-card__content {
    padding: 1rem;
  }

  .cp-product-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cp-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .cp-product-card__title a:hover {
    color: var(--color-primary);
  }

  .cp-product-card__price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .cp-product-card__price-compare {
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    text-decoration: line-through;
    margin-right: 0.5rem;
  }

  .cp-product-card__add-btn {
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: opacity 0.3s, transform 0.2s;
  }

  .cp-product-card__add-btn:hover {
    opacity: 0.9;
    transform: scale(1.02);
  }

  .cp-product-card__sold-out-btn {
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
    background: #e5e7eb;
    border: none;
    border-radius: var(--border-radius);
    cursor: not-allowed;
  }

  /* See More Link */
  .collections-products__see-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    border: 2px solid var(--color-primary);
    border-radius: var(--border-radius);
    transition: all 0.3s;
  }

  .collections-products__see-more:hover {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    border-color: transparent;
  }

  .collections-products__see-more svg {
    transition: transform 0.3s;
  }

  .collections-products__see-more:hover svg {
    transform: translateX(4px);
  }

  /* Divider */
  .collections-products__divider {
    height: 1px;
    background: rgba(var(--color-foreground-rgb), 0.1);
    margin: 0;
    border: none;
  }
{%- endstyle -%}

<section class="collections-products">
  <div class="collections-products__container">
    {%- for collection in collections -%}
      {%- if collection.products.size > 0 and collection.handle != 'all' -%}
        <div class="collections-products__collection">
          <header class="collections-products__header">
            <h2 class="collections-products__title">{{ collection.title }}</h2>
          </header>

          <div class="collections-products__grid">
            {%- for product in collection.products limit: 4 -%}
              <div class="cp-product-card">
                {%- if product.compare_at_price > product.price -%}
                  {%- assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
                  <span class="cp-product-card__badge">-{{ discount_percent }}%</span>
                {%- elsif product.available == false -%}
                  <span class="cp-product-card__sold-out-badge">Sold out</span>
                {%- endif -%}

                <div class="cp-product-card__image">
                  <a href="{{ product.url | within: collection }}" aria-label="{{ product.title }}">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 500 }}"
                        srcset="{{ product.featured_image | image_url: width: 250 }} 250w, {{ product.featured_image | image_url: width: 500 }} 500w"
                        sizes="(max-width: 500px) 50vw, 25vw"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="{{ product.featured_image.width }}"
                        height="{{ product.featured_image.height }}"
                      >
                    {%- else -%}
                      <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #ccc;">
                        {% render 'icon-product-placeholder' %}
                      </div>
                    {%- endif -%}
                  </a>
                </div>

                <div class="cp-product-card__content">
                  <h3 class="cp-product-card__title">
                    <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                  </h3>
                  
                  <div class="cp-product-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="cp-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                    {{ product.price | money }}
                  </div>

                  {%- if product.available -%}
                    <form method="post" action="/cart/add">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="cp-product-card__add-btn">
                        Add to cart
                      </button>
                    </form>
                  {%- else -%}
                    <button type="button" class="cp-product-card__sold-out-btn" disabled>
                      Sold out
                    </button>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <a href="{{ collection.url }}" class="collections-products__see-more">
            See more {{ collection.title }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <hr class="collections-products__divider">
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections with Products",
  "tag": "section",
  "class": "section-collections-products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_collection",
      "label": "Products per collection",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Collections with Products"
    }
  ]
}
{% endschema %}
