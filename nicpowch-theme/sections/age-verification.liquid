{%- comment -%}
  NicPowch Age Verification Modal
  Displays on first visit to verify user is 18+
{%- endcomment -%}

{%- style -%}
  .age-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
    padding: 1rem;
  }

  .age-gate.hidden {
    display: none;
  }

  .age-gate__modal {
    background: white;
    border-radius: var(--border-radius-large);
    max-width: 480px;
    width: 100%;
    padding: 2.5rem;
    text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    animation: ageGateSlideIn 0.3s ease-out;
  }

  @keyframes ageGateSlideIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(-10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .age-gate__logo {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2rem;
    font-weight: 700;
  }

  .age-gate__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
  }

  .age-gate__subtitle {
    font-size: 1rem;
    color: rgba(var(--color-foreground-rgb), 0.7);
    margin: 0 0 2rem;
  }

  .age-gate__question {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: var(--color-foreground);
  }

  .age-gate__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .age-gate__btn {
    flex: 1;
    max-width: 140px;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }

  .age-gate__btn--yes {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
  }

  .age-gate__btn--yes:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(var(--color-primary-rgb), 0.4);
  }

  .age-gate__btn--no {
    background: rgba(var(--color-foreground-rgb), 0.1);
    color: var(--color-foreground);
  }

  .age-gate__btn--no:hover {
    background: rgba(var(--color-foreground-rgb), 0.15);
  }

  .age-gate__disclaimer {
    font-size: 0.75rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    margin: 0;
    line-height: 1.5;
  }

  .age-gate__exit {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111827;
    padding: 1rem;
  }

  .age-gate__exit.hidden {
    display: none;
  }

  .age-gate__exit-content {
    text-align: center;
    color: white;
    max-width: 400px;
  }

  .age-gate__exit-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .age-gate__exit-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .age-gate__exit-text {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }

  .age-gate__exit-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: white;
    color: #111827;
    border-radius: var(--border-radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .age-gate__exit-btn:hover {
    background: rgba(255, 255, 255, 0.9);
  }
{%- endstyle -%}

{%- if section.settings.enable_age_gate -%}
  <div id="age-gate" class="age-gate">
    <div class="age-gate__modal">
      <div class="age-gate__logo">
        18+
      </div>
      <h2 class="age-gate__title">{{ section.settings.title | default: 'Age Verification Required' }}</h2>
      <p class="age-gate__subtitle">{{ section.settings.subtitle | default: 'This website contains nicotine products' }}</p>
      <p class="age-gate__question">{{ section.settings.question | default: 'Are you 18 years of age or older?' }}</p>
      <div class="age-gate__buttons">
        <button type="button" class="age-gate__btn age-gate__btn--yes" id="age-gate-yes">
          Yes, I am 18+
        </button>
        <button type="button" class="age-gate__btn age-gate__btn--no" id="age-gate-no">
          No, I'm not
        </button>
      </div>
      <p class="age-gate__disclaimer">
        {{ section.settings.disclaimer | default: 'By entering this site you are agreeing to our Terms of Use and Privacy Policy. This website is intended for adults only.' }}
      </p>
    </div>
  </div>

  <div id="age-gate-exit" class="age-gate__exit hidden">
    <div class="age-gate__exit-content">
      <div class="age-gate__exit-icon">🚫</div>
      <h2 class="age-gate__exit-title">Sorry, you must be 18+ to enter</h2>
      <p class="age-gate__exit-text">
        This website sells nicotine products which are only available to adults (18 years or older) in the UK.
      </p>
      <a href="https://www.google.com" class="age-gate__exit-btn">Leave Site</a>
    </div>
  </div>

  <script>
    (function() {
      const AGE_VERIFIED_KEY = 'nicpowch_age_verified';
      const AGE_VERIFIED_EXPIRY = 30 * 24 * 60 * 60 * 1000; // 30 days

      const ageGate = document.getElementById('age-gate');
      const ageGateExit = document.getElementById('age-gate-exit');
      const yesBtn = document.getElementById('age-gate-yes');
      const noBtn = document.getElementById('age-gate-no');

      // Check if already verified
      function isVerified() {
        try {
          const stored = localStorage.getItem(AGE_VERIFIED_KEY);
          if (!stored) return false;
          const data = JSON.parse(stored);
          if (Date.now() > data.expiry) {
            localStorage.removeItem(AGE_VERIFIED_KEY);
            return false;
          }
          return data.verified === true;
        } catch (e) {
          return false;
        }
      }

      // Set verified
      function setVerified() {
        try {
          const data = {
            verified: true,
            expiry: Date.now() + AGE_VERIFIED_EXPIRY
          };
          localStorage.setItem(AGE_VERIFIED_KEY, JSON.stringify(data));
        } catch (e) {
          // localStorage not available
        }
      }

      // Initialize
      if (isVerified()) {
        ageGate.classList.add('hidden');
      } else {
        document.body.style.overflow = 'hidden';
      }

      // Event handlers
      if (yesBtn) {
        yesBtn.addEventListener('click', function() {
          setVerified();
          ageGate.classList.add('hidden');
          document.body.style.overflow = '';
        });
      }

      if (noBtn) {
        noBtn.addEventListener('click', function() {
          ageGate.classList.add('hidden');
          ageGateExit.classList.remove('hidden');
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Age Verification",
  "class": "section-age-gate",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_age_gate",
      "label": "Enable age verification gate",
      "default": true,
      "info": "Shows a modal on first visit requiring users to confirm they are 18+"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Age Verification Required"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "This website contains nicotine products"
    },
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Are you 18 years of age or older?"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By entering this site you are agreeing to our Terms of Use and Privacy Policy. This website is intended for adults only."
    }
  ]
}
{% endschema %}
