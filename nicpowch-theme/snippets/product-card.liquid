{%- comment -%}
  Product Card Snippet
  Displays a single product in a card format
{%- endcomment -%}

{%- liquid
  assign product_url = product.url
  assign product_title = product.title
  assign product_vendor = product.vendor
  assign product_price = product.price | money
  assign product_image = product.featured_image
-%}

<article class="product-card">
  <a href="{{ product_url }}" class="product-card__link" aria-label="{{ product_title }}">
    <div class="product-card__image-container">
      {%- if product_image -%}
        <img
          class="product-card__image"
          src="{{ product_image | image_url: width: 500 }}"
          srcset="{{ product_image | image_url: width: 250 }} 250w, {{ product_image | image_url: width: 500 }} 500w, {{ product_image | image_url: width: 750 }} 750w"
          sizes="(max-width: 500px) 100vw, (max-width: 750px) 50vw, 25vw"
          alt="{{ product_image.alt | default: product_title | escape }}"
          loading="lazy"
          width="{{ product_image.width }}"
          height="{{ product_image.height }}"
        >
      {%- else -%}
        <div class="product-card__image product-card__image--placeholder">
          {% render 'icon-product-placeholder' %}
        </div>
      {%- endif -%}

      {%- if product_vendor -%}
        <span class="product-card__vendor-badge">{{ product_vendor }}</span>
      {%- endif -%}
    </div>

    <div class="product-card__content">
      <h3 class="product-card__title">{{ product_title }}</h3>
      <p class="product-card__price">{{ product_price }}</p>
      <span class="product-card__cta">
        View product
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </span>
    </div>
  </a>
</article>

<style>
  .product-card {
    border-radius: var(--border-radius);
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .product-card:hover {
    box-shadow: 0 35px 80px rgba(var(--color-primary-rgb), 0.12);
    transform: translateY(-2px);
  }

  .product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-container {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-secondary-rgb), 0.05));
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground-rgb), 0.3);
  }

  .product-card__vendor-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground);
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 9999px;
  }

  .product-card__content {
    padding: 1.5rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }

  .product-card:hover .product-card__title {
    color: var(--color-primary);
  }

  .product-card__price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
