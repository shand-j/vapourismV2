{%- style -%}
  .rich-text {
    padding: var(--spacing-sections-mobile) 1.5rem;
  }

  @media (min-width: 750px) {
    .rich-text {
      padding: var(--spacing-sections-desktop) 1.5rem;
    }
  }

  .rich-text__container {
    max-width: var(--page-width);
    margin: 0 auto;
    text-align: center;
  }

  .rich-text__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 750px) {
    .rich-text__heading {
      font-size: 2.5rem;
    }
  }

  .rich-text__text {
    font-size: 1.125rem;
    color: rgba(var(--color-foreground-rgb), 0.7);
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  .rich-text__text p {
    margin: 0;
  }
{%- endstyle -%}

<section class="rich-text">
  <div class="rich-text__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rich-text__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rich text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this text to share information about your brand with your customers.</p>"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
