[
  {
    "name": "theme_info",
    "theme_name": "NicPowch",
    "theme_version": "1.0.0",
    "theme_author": "VapourismV2",
    "theme_documentation_url": "https://github.com/shand-j/vapourismV2",
    "theme_support_url": "https://github.com/shand-j/vapourismV2/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#0d9488"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color",
        "default": "#10b981"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#14b8a6"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text color",
        "default": "#0f172a"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "inter_n6",
        "label": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "inter_n4",
        "label": "Body font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "default": 1400,
        "unit": "px",
        "label": "Page width"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 40
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Border radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "px",
        "label": "Logo width"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Age Verification",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_age_verification",
        "label": "Enable age verification",
        "default": true,
        "info": "Required for nicotine products in the UK"
      },
      {
        "type": "text",
        "id": "age_verification_title",
        "label": "Modal title",
        "default": "Age Verification Required"
      },
      {
        "type": "richtext",
        "id": "age_verification_message",
        "label": "Modal message",
        "default": "<p>You must be 18 years or older to purchase nicotine products. By entering this site, you confirm you are of legal age.</p>"
      },
      {
        "type": "text",
        "id": "age_verification_confirm_button",
        "label": "Confirm button text",
        "default": "I am 18 or older"
      },
      {
        "type": "text",
        "id": "age_verification_deny_button",
        "label": "Deny button text",
        "default": "I am under 18"
      },
      {
        "type": "url",
        "id": "age_verification_deny_url",
        "label": "Redirect URL for underage visitors",
        "info": "Where to redirect visitors who are under 18"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter/X",
        "info": "https://twitter.com/shopify"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@shopify"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer",
        "label": "Cart type"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "default": true,
        "label": "Show vendor"
      }
    ]
  }
]
