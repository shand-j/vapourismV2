{%- comment -%}
  NicPowch Visual Hero Section
  Full-screen immersive hero with large brand imagery
  Inspired by nicpouches.com visual impact
{%- endcomment -%}

{%- style -%}
  .hero-visual {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #0f172a;
    display: flex;
    align-items: center;
  }

  @media (max-width: 989px) {
    .hero-visual {
      min-height: 85vh;
    }
  }

  /* Full-screen background image */
  .hero-visual__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-visual__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    filter: brightness(0.8);
  }

  .hero-visual__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.95) 0%,
      rgba(15, 23, 42, 0.7) 40%,
      rgba(var(--color-primary-rgb), 0.15) 100%
    );
  }

  /* Animated gradient orbs */
  .hero-visual__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: orbFloat 10s ease-in-out infinite;
  }

  .hero-visual__orb--1 {
    width: 600px;
    height: 600px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    top: -10%;
    right: -5%;
    animation-delay: 0s;
  }

  .hero-visual__orb--2 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, #06b6d4, var(--color-primary));
    bottom: -5%;
    left: 10%;
    animation-delay: -3s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -30px) scale(1.05); }
    50% { transform: translate(-10px, 20px) scale(0.95); }
    75% { transform: translate(30px, 10px) scale(1.02); }
  }

  .hero-visual__container {
    position: relative;
    z-index: 2;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
  }

  @media (min-width: 990px) {
    .hero-visual__container {
      padding: 5rem 2rem;
    }
  }

  .hero-visual__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 990px) {
    .hero-visual__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  /* Content side */
  .hero-visual__content {
    color: white;
    text-align: center;
  }

  @media (min-width: 990px) {
    .hero-visual__content {
      text-align: left;
    }
  }

  .hero-visual__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 9999px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(var(--color-primary-rgb), 0.5),
                0 0 60px rgba(var(--color-primary-rgb), 0.2);
    animation: badgePulse 3s ease-in-out infinite;
  }

  @keyframes badgePulse {
    0%, 100% { box-shadow: 0 10px 40px rgba(var(--color-primary-rgb), 0.5), 0 0 60px rgba(var(--color-primary-rgb), 0.2); }
    50% { box-shadow: 0 15px 50px rgba(var(--color-primary-rgb), 0.7), 0 0 80px rgba(var(--color-primary-rgb), 0.3); }
  }

  /* MASSIVE typography - competitor-matching */
  .hero-visual__title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    color: white;
    letter-spacing: -0.035em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 750px) {
    .hero-visual__title {
      font-size: 5rem;
    }
  }

  @media (min-width: 990px) {
    .hero-visual__title {
      font-size: 6.5rem;
    }
  }

  @media (min-width: 1200px) {
    .hero-visual__title {
      font-size: 7.5rem;
    }
  }

  .hero-visual__title-line {
    display: block;
  }

  .hero-visual__title-accent {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease-in-out infinite;
    text-shadow: none;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-visual__description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 2.5rem;
    max-width: 520px;
  }

  @media (min-width: 990px) {
    .hero-visual__description {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 990px) {
    .hero-visual__content .hero-visual__description {
      margin-left: 0;
      margin-right: auto;
    }
  }

  @media (max-width: 989px) {
    .hero-visual__description {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hero-visual__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 500px) {
    .hero-visual__buttons {
      flex-direction: row;
      justify-content: center;
      gap: 1.25rem;
    }
  }

  @media (min-width: 990px) {
    .hero-visual__buttons {
      justify-content: flex-start;
    }
  }

  .hero-visual__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
  }

  .hero-visual__button--primary {
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    box-shadow: 0 10px 40px rgba(var(--color-primary-rgb), 0.5);
  }

  .hero-visual__button--primary:hover {
    transform: translateY(-5px) scale(1.03);
    box-shadow: 0 18px 50px rgba(var(--color-primary-rgb), 0.6);
  }

  .hero-visual__button--secondary {
    color: white;
    background-color: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .hero-visual__button--secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-5px);
  }

  /* Brand image showcase side */
  .hero-visual__showcase {
    position: relative;
    display: none;
  }

  @media (min-width: 990px) {
    .hero-visual__showcase {
      display: block;
    }
  }

  .hero-visual__showcase-main {
    position: relative;
    border-radius: calc(var(--border-radius) * 3);
    overflow: hidden;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4),
                0 0 0 1px rgba(255, 255, 255, 0.1);
    transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
    transition: transform 0.5s ease;
  }

  .hero-visual__showcase-main:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg);
  }

  .hero-visual__showcase-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  .hero-visual__showcase-badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--border-radius);
    box-shadow: 0 8px 25px rgba(var(--color-primary-rgb), 0.5);
  }

  /* Brand logos strip */
  .hero-visual__brands {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-visual__brands-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 1rem;
    text-align: center;
  }

  @media (min-width: 990px) {
    .hero-visual__brands-title {
      text-align: left;
    }
  }

  .hero-visual__brands-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  @media (min-width: 990px) {
    .hero-visual__brands-list {
      justify-content: flex-start;
    }
  }

  .hero-visual__brands-item {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
  }

  .hero-visual__brands-item:hover {
    color: white;
  }

  /* Scroll indicator */
  .hero-visual__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.5);
    animation: bounceDown 2s ease-in-out infinite;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  .hero-visual__scroll-text {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .hero-visual__scroll-icon {
    width: 24px;
    height: 24px;
  }
{%- endstyle -%}

<section class="hero-visual">
  {%- if section.settings.background_image -%}
    <div class="hero-visual__bg">
      <img 
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="NicPowch Hero Background"
        class="hero-visual__bg-image"
        loading="eager"
        fetchpriority="high"
      >
      <div class="hero-visual__bg-overlay"></div>
    </div>
  {%- endif -%}

  <div class="hero-visual__orb hero-visual__orb--1"></div>
  <div class="hero-visual__orb hero-visual__orb--2"></div>

  <div class="hero-visual__container">
    <div class="hero-visual__grid">
      <div class="hero-visual__content">
        {%- if section.settings.badge_text != blank -%}
          <span class="hero-visual__badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
            {{ section.settings.badge_text }}
          </span>
        {%- endif -%}

        <h1 class="hero-visual__title">
          <span class="hero-visual__title-line">{{ section.settings.title_line_1 | default: "Premium" }}</span>
          <span class="hero-visual__title-line hero-visual__title-accent">{{ section.settings.title_line_2 | default: "Nicotine" }}</span>
          <span class="hero-visual__title-line">{{ section.settings.title_line_3 | default: "Pouches" }}</span>
        </h1>

        <p class="hero-visual__description">
          {{ section.settings.description | default: "Discover tobacco-free satisfaction. Discreet, smoke-free pouches from top brands—delivered next-day across the UK." }}
        </p>

        <div class="hero-visual__buttons">
          {%- if section.settings.button_primary_text != blank -%}
            <a href="{{ section.settings.button_primary_url | default: '/collections/nicotine-pouches' }}" class="hero-visual__button hero-visual__button--primary">
              {{ section.settings.button_primary_text }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.button_secondary_text != blank -%}
            <a href="{{ section.settings.button_secondary_url | default: '/collections' }}" class="hero-visual__button hero-visual__button--secondary">
              {{ section.settings.button_secondary_text }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_brands -%}
          <div class="hero-visual__brands">
            <p class="hero-visual__brands-title">Trusted Brands</p>
            <ul class="hero-visual__brands-list">
              <li class="hero-visual__brands-item">VELO</li>
              <li class="hero-visual__brands-item">KILLA</li>
              <li class="hero-visual__brands-item">Nordic Spirit</li>
              <li class="hero-visual__brands-item">Pablo</li>
              <li class="hero-visual__brands-item">On!</li>
            </ul>
          </div>
        {%- endif -%}
      </div>

      <div class="hero-visual__showcase">
        {%- if section.settings.showcase_image -%}
          <div class="hero-visual__showcase-main">
            <img 
              src="{{ section.settings.showcase_image | image_url: width: 800 }}"
              alt="{{ section.settings.showcase_badge | default: 'Featured' }}"
              class="hero-visual__showcase-image"
              loading="eager"
            >
            {%- if section.settings.showcase_badge != blank -%}
              <span class="hero-visual__showcase-badge">{{ section.settings.showcase_badge }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero-visual__scroll">
      <span class="hero-visual__scroll-text">Scroll</span>
      <svg class="hero-visual__scroll-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Visual",
  "tag": "section",
  "class": "section-hero-visual",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Tobacco-free • 18+ verified"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Premium"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Accent)",
      "default": "Nicotine"
    },
    {
      "type": "text",
      "id": "title_line_3",
      "label": "Title Line 3",
      "default": "Pouches"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover tobacco-free satisfaction. Discreet, smoke-free pouches from top brands—delivered next-day across the UK."
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Primary Button Text",
      "default": "Shop All Pouches"
    },
    {
      "type": "url",
      "id": "button_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary Button Text",
      "default": "Shop by Brand"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_brands",
      "label": "Show Brand Names",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "showcase_image",
      "label": "Showcase Image"
    },
    {
      "type": "text",
      "id": "showcase_badge",
      "label": "Showcase Badge Text",
      "default": "Featured"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Visual"
    }
  ]
}
{% endschema %}
