{%- comment -%}
  Enhanced Product Card Snippet
  Visual product card with strength badges, price-per-pouch like nicpouches.com
  
  Usage: {% render 'product-card-enhanced', product: product %}
{%- endcomment -%}

{%- liquid
  assign product_url = product.url
  assign product_title = product.title
  assign product_vendor = product.vendor
  assign product_price = product.price
  assign product_compare_price = product.compare_at_price
  assign product_image = product.featured_image
  assign is_on_sale = false
  if product_compare_price > product_price
    assign is_on_sale = true
    assign savings = product_compare_price | minus: product_price
  endif
  
  # Extract nicotine strength from tags or metafields
  assign nicotine_strength = ''
  for tag in product.tags
    if tag contains 'mg'
      assign nicotine_strength = tag
      break
    endif
  endfor
  
  # Check for mix & match tag
  assign is_mix_match = false
  if product.tags contains 'mix-match' or product.tags contains 'Mix & Match'
    assign is_mix_match = true
  endif
  
  # Calculate price per pouch (assume 20 pouches per can if not specified)
  assign pouches_per_can = 20
  assign price_per_pouch = product_price | divided_by: pouches_per_can
-%}

<article class="epc">
  {%- if is_mix_match -%}
    <div class="epc__badge epc__badge--mix">MIX & MATCH</div>
  {%- elsif is_on_sale -%}
    <div class="epc__badge epc__badge--sale">SALE</div>
  {%- endif -%}
  
  <a href="{{ product_url }}" class="epc__image-link">
    <div class="epc__image-container">
      {%- if product_image -%}
        <img
          class="epc__image"
          src="{{ product_image | image_url: width: 400 }}"
          srcset="{{ product_image | image_url: width: 200 }} 200w, {{ product_image | image_url: width: 400 }} 400w, {{ product_image | image_url: width: 600 }} 600w"
          sizes="(max-width: 500px) 50vw, (max-width: 750px) 33vw, 25vw"
          alt="{{ product_image.alt | default: product_title | escape }}"
          loading="lazy"
          width="{{ product_image.width }}"
          height="{{ product_image.height }}"
        >
      {%- else -%}
        <div class="epc__image epc__image--placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </div>
      {%- endif -%}
      
      {%- if nicotine_strength != blank -%}
        <div class="epc__strength">{{ nicotine_strength }}</div>
      {%- endif -%}
    </div>
  </a>
  
  <div class="epc__content">
    {%- if product_vendor -%}
      <p class="epc__vendor">{{ product_vendor }}</p>
    {%- endif -%}
    
    <h3 class="epc__title">
      <a href="{{ product_url }}">{{ product_title }}</a>
    </h3>
    
    <div class="epc__pricing">
      <span class="epc__price">{{ product_price | money }}</span>
      {%- if is_on_sale -%}
        <span class="epc__compare-price">{{ product_compare_price | money }}</span>
      {%- endif -%}
    </div>
    
    <div class="epc__footer">
      <span class="epc__per-pouch">{{ price_per_pouch | money }}/pouch</span>
      {%- if is_on_sale -%}
        <span class="epc__savings">Save {{ savings | money }}</span>
      {%- endif -%}
    </div>
    
    {%- if product.available -%}
      <button 
        type="button" 
        class="epc__add-btn"
        data-product-id="{{ product.variants.first.id }}"
        onclick="addToCartQuick({{ product.variants.first.id }})"
      >
        Add to Cart
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    {%- else -%}
      <button type="button" class="epc__add-btn epc__add-btn--sold-out" disabled>
        Sold Out
      </button>
    {%- endif -%}
  </div>
</article>

<style>
  .epc {
    position: relative;
    background: white;
    border-radius: calc(var(--border-radius) * 1.5);
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .epc:hover {
    box-shadow: 0 12px 40px rgba(var(--color-primary-rgb), 0.15);
    transform: translateY(-4px);
  }

  .epc__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    border-radius: 4px;
    z-index: 2;
  }

  .epc__badge--sale {
    background: #dc2626;
  }

  .epc__badge--mix {
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
  }

  .epc__image-link {
    display: block;
  }

  .epc__image-container {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.03), rgba(var(--color-secondary-rgb), 0.03));
  }

  .epc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .epc:hover .epc__image {
    transform: scale(1.08);
  }

  .epc__image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground-rgb), 0.2);
  }

  .epc__strength {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 4px;
  }

  .epc__content {
    padding: 1rem;
  }

  .epc__vendor {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }

  .epc__title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    min-height: 2.4em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .epc__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }

  .epc:hover .epc__title a {
    color: var(--color-primary);
  }

  .epc__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .epc__price {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-foreground);
  }

  .epc__compare-price {
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    text-decoration: line-through;
  }

  .epc__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .epc__per-pouch {
    font-size: 0.75rem;
    color: rgba(var(--color-foreground-rgb), 0.6);
  }

  .epc__savings {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #16a34a;
    background: rgba(22, 163, 74, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .epc__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.3s;
  }

  .epc__add-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(var(--color-primary-rgb), 0.4);
  }

  .epc__add-btn:active {
    transform: translateY(0);
  }

  .epc__add-btn svg {
    transition: transform 0.3s;
  }

  .epc__add-btn:hover svg {
    transform: translateX(3px);
  }

  .epc__add-btn--sold-out {
    background: rgba(var(--color-foreground-rgb), 0.3);
    cursor: not-allowed;
  }

  .epc__add-btn--sold-out:hover {
    transform: none;
    box-shadow: none;
  }
</style>

<script>
  function addToCartQuick(variantId) {
    const btn = event.target.closest('.epc__add-btn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span>Adding...</span>';
    btn.disabled = true;
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerHTML = '<span>Added! ✓</span>';
      // Update cart count
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          if (window.updateCartCount) {
            window.updateCartCount(cart.item_count);
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        });
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 1500);
    })
    .catch(err => {
      btn.innerHTML = '<span>Error</span>';
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 1500);
    });
  }
</script>
