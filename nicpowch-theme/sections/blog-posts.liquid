{%- comment -%}
  Blog Posts Section
  "From the Blog" section showing recent blog posts
  Matches nicpouch.co.uk homepage blog section
{%- endcomment -%}

{%- style -%}
  .blog-section {
    padding: var(--spacing-sections-mobile) 0;
    background: {{ section.settings.background_color | default: '#ffffff' }};
  }

  @media (min-width: 990px) {
    .blog-section {
      padding: var(--spacing-sections-desktop) 0;
    }
  }

  .blog-section__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-section__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .blog-section__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 750px) {
    .blog-section__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-card {
    background: white;
    border-radius: var(--border-radius-large);
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .blog-card:hover {
    box-shadow: 0 8px 30px rgba(var(--color-primary-rgb), 0.12);
    transform: translateY(-2px);
  }

  .blog-card__image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.1), rgba(var(--color-secondary-rgb), 0.1));
  }

  .blog-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-card__image img {
    transform: scale(1.05);
  }

  .blog-card__content {
    padding: 1.5rem;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    margin-bottom: 0.75rem;
  }

  .blog-card__meta-sep {
    color: rgba(var(--color-foreground-rgb), 0.3);
  }

  .blog-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card__title a:hover {
    color: var(--color-primary);
  }

  .blog-card__excerpt {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground-rgb), 0.7);
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.3s;
  }

  .blog-card__link:hover {
    gap: 0.75rem;
  }

  .blog-card__link svg {
    transition: transform 0.3s;
  }

  .blog-card__link:hover svg {
    transform: translateX(2px);
  }

  /* Empty state */
  .blog-section__empty {
    text-align: center;
    padding: 3rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
  }
{%- endstyle -%}

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign posts_to_show = section.settings.posts_to_show | default: 3
-%}

<section class="blog-section">
  <div class="blog-section__container">
    <header class="blog-section__header">
      <h2 class="blog-section__title">{{ section.settings.title | default: 'From the Blog' }}</h2>
    </header>

    {%- if blog != blank and blog.articles_count > 0 -%}
      <div class="blog-section__grid">
        {%- for article in blog.articles limit: posts_to_show -%}
          <article class="blog-card">
            {%- if article.image -%}
              <div class="blog-card__image">
                <a href="{{ article.url }}">
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    srcset="{{ article.image | image_url: width: 300 }} 300w, {{ article.image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 750px) 100vw, 33vw"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                </a>
              </div>
            {%- endif -%}

            <div class="blog-card__content">
              <div class="blog-card__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </time>
                {%- assign reading_time = article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 -%}
                <span class="blog-card__meta-sep">•</span>
                <span>{{ reading_time }} min read</span>
              </div>

              <h3 class="blog-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {%- if article.excerpt != blank -%}
                <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 150 }}</p>
              {%- else -%}
                <p class="blog-card__excerpt">{{ article.content | strip_html | truncate: 150 }}</p>
              {%- endif -%}

              <a href="{{ article.url }}" class="blog-card__link">
                Read more
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="blog-section__empty">
        <p>No blog posts yet. Check back soon for news and articles!</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Posts",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From the Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Blog Posts",
      "settings": {
        "title": "From the Blog",
        "posts_to_show": 3
      }
    }
  ]
}
{% endschema %}
