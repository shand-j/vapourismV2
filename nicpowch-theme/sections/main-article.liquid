{%- comment -%}
  NicPowch Article Page
  Displays a single blog article
{%- endcomment -%}

{%- style -%}
  .main-article {
    padding: var(--spacing-sections-mobile) 0;
  }

  @media (min-width: 990px) {
    .main-article {
      padding: var(--spacing-sections-desktop) 0;
    }
  }

  .main-article__container {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .main-article__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .main-article__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.6);
    margin-bottom: 1rem;
  }

  .main-article__tag {
    display: inline-flex;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
    border-radius: 9999px;
    text-decoration: none;
  }

  .main-article__tag:hover {
    background: rgba(var(--color-primary-rgb), 0.15);
  }

  .main-article__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--color-foreground);
  }

  @media (min-width: 750px) {
    .main-article__title {
      font-size: 2.5rem;
    }
  }

  .main-article__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--border-radius-large);
    margin-bottom: 2rem;
  }

  .main-article__content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-foreground);
  }

  .main-article__content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
    color: var(--color-foreground);
  }

  .main-article__content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }

  .main-article__content p {
    margin: 0 0 1.25rem;
  }

  .main-article__content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .main-article__content ul,
  .main-article__content ol {
    margin: 0 0 1.25rem 1.5rem;
  }

  .main-article__content li {
    margin-bottom: 0.5rem;
  }

  .main-article__content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    margin: 1.5rem 0;
  }

  .main-article__content blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.05);
    font-style: italic;
  }

  .main-article__footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .main-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .main-article__share {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .main-article__share-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .main-article__share-links {
    display: flex;
    gap: 0.5rem;
  }

  .main-article__share-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground-rgb), 0.1);
    color: var(--color-foreground);
    text-decoration: none;
    transition: all 0.2s;
  }

  .main-article__share-link:hover {
    background: var(--color-primary);
    color: white;
  }

  .main-article__nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .main-article__nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-foreground);
    max-width: 45%;
  }

  .main-article__nav-link:hover {
    color: var(--color-primary);
  }

  .main-article__nav-label {
    font-size: 0.75rem;
    color: rgba(var(--color-foreground-rgb), 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .main-article__nav-title {
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .main-article__nav-link--next {
    text-align: right;
    margin-left: auto;
  }

  .main-article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .main-article__back:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

<article class="main-article">
  <div class="main-article__container">
    <header class="main-article__header">
      <div class="main-article__meta">
        {%- if article.tags.size > 0 -%}
          <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="main-article__tag">
            {{ article.tags.first }}
          </a>
        {%- endif -%}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
        {%- if article.author -%}
          <span>by {{ article.author }}</span>
        {%- endif -%}
      </div>
      <h1 class="main-article__title">{{ article.title }}</h1>
    </header>

    {%- if article.image -%}
      <img 
        src="{{ article.image | image_url: width: 1200 }}"
        srcset="{{ article.image | image_url: width: 600 }} 600w,
                {{ article.image | image_url: width: 900 }} 900w,
                {{ article.image | image_url: width: 1200 }} 1200w"
        sizes="(max-width: 48rem) 100vw, 48rem"
        alt="{{ article.image.alt | escape | default: article.title }}"
        loading="eager"
        class="main-article__image"
      >
    {%- endif -%}

    <div class="main-article__content rte">
      {{ article.content }}
    </div>

    <footer class="main-article__footer">
      {%- if article.tags.size > 0 -%}
        <div class="main-article__tags">
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="main-article__tag">
              {{ tag }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="main-article__share">
        <span class="main-article__share-label">Share:</span>
        <div class="main-article__share-links">
          <a href="https://twitter.com/intent/tweet?url={{ article.url | absolute_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" class="main-article__share-link" aria-label="Share on Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ article.url | absolute_url | url_encode }}" target="_blank" rel="noopener" class="main-article__share-link" aria-label="Share on Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="mailto:?subject={{ article.title | url_encode }}&body={{ article.url | absolute_url | url_encode }}" class="main-article__share-link" aria-label="Share via Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </a>
        </div>
      </div>

      {%- if blog.previous_article or blog.next_article -%}
        <nav class="main-article__nav">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article }}" class="main-article__nav-link">
              <span class="main-article__nav-label">← Previous</span>
              <span class="main-article__nav-title">{{ blog.previous_article.title }}</span>
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a href="{{ blog.next_article }}" class="main-article__nav-link main-article__nav-link--next">
              <span class="main-article__nav-label">Next →</span>
              <span class="main-article__nav-title">{{ blog.next_article.title }}</span>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}

      <a href="{{ blog.url }}" class="main-article__back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to {{ blog.title }}
      </a>
    </footer>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons",
      "default": true
    }
  ]
}
{% endschema %}
