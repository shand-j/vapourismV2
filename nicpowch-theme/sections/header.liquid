{%- comment -%}
  NicPowch Header Section
  Premium nicotine pouches UK - clean navigation matching competitor
{%- endcomment -%}

{%- style -%}
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: white;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  .header__announcement {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    padding: 0.625rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .header__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header__logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header__logo-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .header__nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 990px) {
    .header__nav {
      display: flex;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    display: block;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link--active {
    color: var(--color-primary);
  }

  /* Dropdown Navigation */
  .header__nav-item {
    position: relative;
  }

  .header__nav-item--dropdown > .header__nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__nav-link-chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .header__nav-item--dropdown:hover .header__nav-link-chevron {
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    padding-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .header__nav-item--dropdown:hover .header__dropdown {
    opacity: 1;
    visibility: visible;
  }

  .header__dropdown-inner {
    background: white;
    border-radius: var(--border-radius);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    overflow: hidden;
  }

  .header__dropdown-section {
    padding: 0.75rem 0;
  }

  .header__dropdown-section:not(:last-child) {
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.08);
  }

  .header__dropdown-title {
    padding: 0.5rem 1.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(var(--color-foreground-rgb), 0.5);
  }

  .header__dropdown-link {
    display: block;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .header__dropdown-link:hover {
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
  }

  .header__dropdown-link--view-all {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: var(--border-radius);
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
    text-decoration: none;
    position: relative;
  }

  .header__action-btn:hover {
    color: var(--color-primary);
    background-color: rgba(var(--color-primary-rgb), 0.1);
  }

  .header__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 9999px;
    transform: scale(1);
    transition: transform 0.2s ease;
  }

  .header__cart-count--hidden {
    transform: scale(0);
  }

  .header__cart-count--animate {
    animation: cartBounce 0.4s ease;
  }

  @keyframes cartBounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  .header__mobile-toggle {
    display: flex;
  }

  @media (min-width: 990px) {
    .header__mobile-toggle {
      display: none;
    }
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }

  .mobile-menu.active {
    display: block;
  }

  .mobile-menu__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    max-width: 85%;
    background: white;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-menu.active .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .mobile-menu__nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__link {
    display: block;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .mobile-menu__link:hover {
    background-color: rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
  }

  /* Mobile Accordion */
  .mobile-menu__accordion {
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.08);
  }

  .mobile-menu__accordion-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .mobile-menu__accordion-toggle:hover {
    background-color: rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
  }

  .mobile-menu__accordion-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .mobile-menu__accordion.active .mobile-menu__accordion-icon {
    transform: rotate(180deg);
  }

  .mobile-menu__accordion-content {
    display: none;
    background: rgba(var(--color-foreground-rgb), 0.02);
  }

  .mobile-menu__accordion.active .mobile-menu__accordion-content {
    display: block;
  }

  .mobile-menu__sub-title {
    padding: 0.75rem 1.5rem 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(var(--color-foreground-rgb), 0.5);
  }

  .mobile-menu__sub-link {
    display: block;
    padding: 0.625rem 1.5rem 0.625rem 2rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .mobile-menu__sub-link:hover {
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
  }

  .mobile-menu__sub-link--view-all {
    color: var(--color-primary);
    font-weight: 600;
    padding-bottom: 0.875rem;
  }

  .mobile-menu__footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .mobile-menu__footer-links {
    display: flex;
    gap: 1rem;
  }

  .mobile-menu__footer-link {
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.6);
    text-decoration: none;
  }

  .mobile-menu__footer-link:hover {
    color: var(--color-primary);
  }

  .mobile-menu__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .mobile-menu__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: rgba(var(--color-foreground-rgb), 0.1);
    color: var(--color-foreground);
    transition: all 0.2s;
  }

  .mobile-menu__social-link:hover {
    background-color: var(--color-primary);
    color: white;
  }
{%- endstyle -%}

<header class="header" role="banner">
  {%- if section.settings.show_announcement -%}
    <div class="header__announcement">
      🚚 FREE UK DELIVERY on all orders over £{{ section.settings.free_shipping_threshold }}
    </div>
  {%- endif -%}

  <div class="header__container">
    <button type="button" class="header__action-btn header__mobile-toggle" aria-label="Open menu" id="mobile-menu-toggle">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name | default: 'NicPowch' }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="Main navigation">
      <ul class="header__nav-list">
        <li class="header__nav-item header__nav-item--dropdown">
          <a href="{{ section.settings.shop_all_url | default: '/collections/nicotine-pouches' }}" class="header__nav-link{% if request.path contains '/collections' %} header__nav-link--active{% endif %}">
            Shop Pouches
            <svg class="header__nav-link-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <div class="header__dropdown">
            <div class="header__dropdown-inner">
              <div class="header__dropdown-section">
                <div class="header__dropdown-title">Shop by Brand</div>
                <a href="/collections/velo" class="header__dropdown-link">Velo</a>
                <a href="/collections/nordic-spirit" class="header__dropdown-link">Nordic Spirit</a>
                <a href="/collections/killa" class="header__dropdown-link">Killa</a>
                <a href="/collections/pablo" class="header__dropdown-link">Pablo</a>
                <a href="/collections/on" class="header__dropdown-link">On!</a>
                <a href="/collections/loop" class="header__dropdown-link">Loop</a>
                <a href="/collections" class="header__dropdown-link header__dropdown-link--view-all">View All Brands →</a>
              </div>
              <div class="header__dropdown-section">
                <div class="header__dropdown-title">Shop by Strength</div>
                <a href="/collections/nicotine-pouches?filter.p.m.custom.nicotine_strength=Low+(1-6mg)" class="header__dropdown-link">Low (1-6mg)</a>
                <a href="/collections/nicotine-pouches?filter.p.m.custom.nicotine_strength=Medium+(7-12mg)" class="header__dropdown-link">Medium (7-12mg)</a>
                <a href="/collections/nicotine-pouches?filter.p.m.custom.nicotine_strength=Strong+(13-20mg)" class="header__dropdown-link">Strong (13-20mg)</a>
                <a href="/collections/nicotine-pouches?filter.p.m.custom.nicotine_strength=Extra+Strong+(20mg%2B)" class="header__dropdown-link">Extra Strong (20mg+)</a>
              </div>
            </div>
          </div>
        </li>
        <li class="header__nav-item">
          <a href="{{ section.settings.offers_url | default: '/collections/sale' }}" class="header__nav-link{% if request.path contains '/collections/sale' %} header__nav-link--active{% endif %}">
            Offers
          </a>
        </li>
        <li class="header__nav-item">
          <a href="{{ section.settings.news_url | default: '/blogs/news' }}" class="header__nav-link{% if request.path contains '/blogs' %} header__nav-link--active{% endif %}">
            News
          </a>
        </li>
        <li class="header__nav-item">
          <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="header__nav-link{% if request.path contains '/pages/contact' %} header__nav-link--active{% endif %}">
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__action-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>

      <a href="{{ routes.account_url }}" class="header__action-btn" aria-label="Log in">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="header__action-btn header__cart" aria-label="Cart" id="header-cart-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="header__cart-count{% if cart.item_count == 0 %} header__cart-count--hidden{% endif %}" id="header-cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

