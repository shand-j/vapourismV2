{%- comment -%}
  NicPowch Fullscreen Hero Section
  Full-viewport immersive hero with massive typography
  Inspired by nicpouches.com competitor design
{%- endcomment -%}

{%- style -%}
  .hero-fullscreen {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #0f172a;
    display: flex;
    align-items: center;
  }

  @media (max-width: 989px) {
    .hero-fullscreen {
      min-height: 90vh;
    }
  }

  /* Full-screen background image */
  .hero-fullscreen__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-fullscreen__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    filter: brightness(0.7);
  }

  .hero-fullscreen__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.92) 0%,
      rgba(15, 23, 42, 0.65) 45%,
      rgba(var(--color-primary-rgb), 0.2) 100%
    );
  }

  /* Animated gradient orbs */
  .hero-fullscreen__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
    animation: orbFloat 12s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-fullscreen__orb--1 {
    width: 700px;
    height: 700px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    top: -15%;
    right: -10%;
    animation-delay: 0s;
  }

  .hero-fullscreen__orb--2 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, #06b6d4, var(--color-primary));
    bottom: -10%;
    left: 5%;
    animation-delay: -4s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(25px, -35px) scale(1.05); }
    50% { transform: translate(-15px, 25px) scale(0.95); }
    75% { transform: translate(35px, 15px) scale(1.03); }
  }

  .hero-fullscreen__container {
    position: relative;
    z-index: 2;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 4rem 1.5rem;
    width: 100%;
  }

  @media (min-width: 990px) {
    .hero-fullscreen__container {
      padding: 6rem 2rem;
    }
  }

  .hero-fullscreen__content {
    color: white;
    max-width: 900px;
  }

  @media (min-width: 990px) {
    .hero-fullscreen__content {
      max-width: 65%;
    }
  }

  .hero-fullscreen__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 9999px;
    margin-bottom: 2.5rem;
    box-shadow: 0 12px 45px rgba(var(--color-primary-rgb), 0.55),
                0 0 80px rgba(var(--color-primary-rgb), 0.25);
    animation: badgePulse 3.5s ease-in-out infinite;
  }

  @keyframes badgePulse {
    0%, 100% { box-shadow: 0 12px 45px rgba(var(--color-primary-rgb), 0.55), 0 0 80px rgba(var(--color-primary-rgb), 0.25); }
    50% { box-shadow: 0 18px 60px rgba(var(--color-primary-rgb), 0.75), 0 0 100px rgba(var(--color-primary-rgb), 0.35); }
  }

  /* MASSIVE typography - competitor-beating */
  .hero-fullscreen__title {
    font-size: 4rem;
    font-weight: 900;
    line-height: 0.92;
    margin: 0 0 2rem;
    color: white;
    letter-spacing: -0.04em;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 750px) {
    .hero-fullscreen__title {
      font-size: 6rem;
    }
  }

  @media (min-width: 990px) {
    .hero-fullscreen__title {
      font-size: 8rem;
    }
  }

  @media (min-width: 1200px) {
    .hero-fullscreen__title {
      font-size: 9.5rem;
    }
  }

  .hero-fullscreen__title-line {
    display: block;
  }

  .hero-fullscreen__title-accent {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 5s ease-in-out infinite;
    text-shadow: none;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-fullscreen__description {
    font-size: 1.375rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 3rem;
    max-width: 580px;
  }

  @media (min-width: 990px) {
    .hero-fullscreen__description {
      font-size: 1.625rem;
    }
  }

  .hero-fullscreen__buttons {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 500px) {
    .hero-fullscreen__buttons {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .hero-fullscreen__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1.375rem 2.75rem;
    font-size: 1.0625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
  }

  .hero-fullscreen__button--primary {
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    box-shadow: 0 12px 45px rgba(var(--color-primary-rgb), 0.55);
  }

  .hero-fullscreen__button--primary:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 22px 60px rgba(var(--color-primary-rgb), 0.65);
  }

  .hero-fullscreen__button--secondary {
    color: white;
    background-color: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(12px);
  }

  .hero-fullscreen__button--secondary:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.65);
    transform: translateY(-6px);
  }

  /* Brand logos strip */
  .hero-fullscreen__brands {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-fullscreen__brands-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1.25rem;
  }

  .hero-fullscreen__brands-list {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-fullscreen__brands-item {
    font-size: 1.125rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .hero-fullscreen__brands-item:hover {
    color: white;
    transform: scale(1.08);
  }

  /* Floating product showcase */
  .hero-fullscreen__showcase {
    position: absolute;
    right: 5%;
    bottom: 15%;
    z-index: 3;
    display: none;
  }

  @media (min-width: 1200px) {
    .hero-fullscreen__showcase {
      display: block;
    }
  }

  .hero-fullscreen__showcase-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: calc(var(--border-radius) * 2.5);
    padding: 1.75rem;
    max-width: 320px;
    color: white;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    transform: translateY(0);
    transition: transform 0.4s ease;
  }

  .hero-fullscreen__showcase-card:hover {
    transform: translateY(-10px);
  }

  .hero-fullscreen__showcase-image {
    width: 100%;
    border-radius: var(--border-radius);
    margin-bottom: 1.25rem;
  }

  .hero-fullscreen__showcase-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .hero-fullscreen__showcase-price {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-secondary);
  }

  /* Scroll indicator */
  .hero-fullscreen__scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    color: rgba(255, 255, 255, 0.5);
    animation: bounceDown 2.5s ease-in-out infinite;
    z-index: 5;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(12px); }
  }

  .hero-fullscreen__scroll-text {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
  }

  .hero-fullscreen__scroll-icon {
    width: 26px;
    height: 26px;
  }
{%- endstyle -%}

<section class="hero-fullscreen">
  {%- if section.settings.background_image -%}
    <div class="hero-fullscreen__bg">
      <img 
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="NicPowch Hero Background"
        class="hero-fullscreen__bg-image"
        loading="eager"
        fetchpriority="high"
      >
      <div class="hero-fullscreen__bg-overlay"></div>
    </div>
  {%- endif -%}

  <div class="hero-fullscreen__orb hero-fullscreen__orb--1"></div>
  <div class="hero-fullscreen__orb hero-fullscreen__orb--2"></div>

  <div class="hero-fullscreen__container">
    <div class="hero-fullscreen__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="hero-fullscreen__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          {{ section.settings.badge_text }}
        </span>
      {%- endif -%}

      <h1 class="hero-fullscreen__title">
        <span class="hero-fullscreen__title-line">{{ section.settings.title_line_1 | default: "Premium" }}</span>
        <span class="hero-fullscreen__title-line hero-fullscreen__title-accent">{{ section.settings.title_line_2 | default: "Nicotine" }}</span>
        <span class="hero-fullscreen__title-line">{{ section.settings.title_line_3 | default: "Pouches" }}</span>
      </h1>

      <p class="hero-fullscreen__description">
        {{ section.settings.description | default: "Discover tobacco-free satisfaction. Discreet, smoke-free pouches from top brands—delivered next-day across the UK." }}
      </p>

      <div class="hero-fullscreen__buttons">
        {%- if section.settings.button_primary_text != blank -%}
          <a href="{{ section.settings.button_primary_url | default: '/collections/nicotine-pouches' }}" class="hero-fullscreen__button hero-fullscreen__button--primary">
            {{ section.settings.button_primary_text }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.button_secondary_text != blank -%}
          <a href="{{ section.settings.button_secondary_url | default: '/collections' }}" class="hero-fullscreen__button hero-fullscreen__button--secondary">
            {{ section.settings.button_secondary_text }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_brands -%}
        <div class="hero-fullscreen__brands">
          <p class="hero-fullscreen__brands-title">Trusted Brands</p>
          <ul class="hero-fullscreen__brands-list">
            <li class="hero-fullscreen__brands-item">VELO</li>
            <li class="hero-fullscreen__brands-item">KILLA</li>
            <li class="hero-fullscreen__brands-item">Nordic Spirit</li>
            <li class="hero-fullscreen__brands-item">Pablo</li>
            <li class="hero-fullscreen__brands-item">On!</li>
            <li class="hero-fullscreen__brands-item">Loop</li>
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero-fullscreen__scroll">
      <span class="hero-fullscreen__scroll-text">Scroll</span>
      <svg class="hero-fullscreen__scroll-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Fullscreen",
  "tag": "section",
  "class": "section-hero-fullscreen",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Tobacco-free • 18+ verified"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Premium"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Accent)",
      "default": "Nicotine"
    },
    {
      "type": "text",
      "id": "title_line_3",
      "label": "Title Line 3",
      "default": "Pouches"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover tobacco-free satisfaction. Discreet, smoke-free pouches from top brands—delivered next-day across the UK."
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Primary Button Text",
      "default": "Shop All Pouches"
    },
    {
      "type": "url",
      "id": "button_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary Button Text",
      "default": "Shop by Brand"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_brands",
      "label": "Show Brand Names",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Fullscreen"
    }
  ]
}
{% endschema %}
