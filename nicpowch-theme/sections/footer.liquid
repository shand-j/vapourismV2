{%- comment -%}
  NicPowch Footer Section
{%- endcomment -%}

{%- style -%}
  .footer {
    background-color: #111827;
    color: white;
    margin-top: auto;
  }

  .footer__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 750px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer__column-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: white;
  }

  .footer__column-text {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__link {
    display: block;
    padding: 0.375rem 0;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover {
    color: white;
  }

  .footer__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 2rem;
    text-align: center;
  }

  .footer__stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .footer__stat-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.25rem;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    text-align: center;
  }

  @media (min-width: 750px) {
    .footer__bottom {
      flex-direction: row;
      text-align: left;
    }
  }

  .footer__copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
    margin: 0;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__legal-link {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer__legal-link:hover {
    color: white;
  }
{%- endstyle -%}

<footer class="footer" role="contentinfo">
  <div class="footer__container">
    <div class="footer__grid">
      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">{{ section.settings.brand_title | default: shop.name }}</h3>
        <p class="footer__column-text">{{ section.settings.brand_description | default: "UK's specialist nicotine pouch retailer. Premium tobacco-free pouches for a smoke-free lifestyle." }}</p>
      </div>

      {%- comment -%} Shop Links {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Shop by Strength</h3>
        <ul class="footer__links">
          <li><a href="/collections/nicotine-pouches?filter.p.tag=3mg" class="footer__link">3mg - Light</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=6mg" class="footer__link">6mg - Medium</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=10mg" class="footer__link">10mg - Strong</a></li>
          <li><a href="/collections/nicotine-pouches?filter.p.tag=20mg" class="footer__link">20mg - Maximum</a></li>
        </ul>
      </div>

      {%- comment -%} Brands {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Popular Brands</h3>
        <ul class="footer__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'brand_link' -%}
              <li><a href="{{ block.settings.url }}" class="footer__link">{{ block.settings.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <li><a href="/collections/velo" class="footer__link">Velo</a></li>
            <li><a href="/collections/zyn" class="footer__link">Zyn</a></li>
            <li><a href="/collections/nordic-spirit" class="footer__link">Nordic Spirit</a></li>
            <li><a href="/collections/on" class="footer__link">On!</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Customer Service {%- endcomment -%}
      <div class="footer__column">
        <h3 class="footer__column-title">Customer Service</h3>
        <ul class="footer__links">
          <li><a href="/pages/delivery-information" class="footer__link">Delivery Information</a></li>
          <li><a href="/pages/returns-policy" class="footer__link">Returns & Refunds</a></li>
          <li><a href="/pages/contact" class="footer__link">Contact Us</a></li>
          <li><a href="/pages/faq" class="footer__link">FAQ</a></li>
          <li><a href="/pages/age-verification" class="footer__link">Age Verification</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__stats">
      <div class="footer__stat">
        <div class="footer__stat-value">FREE</div>
        <div class="footer__stat-label">Delivery on orders over £30</div>
      </div>
      <div class="footer__stat">
        <div class="footer__stat-value" style="color: var(--color-secondary);">1pm</div>
        <div class="footer__stat-label">Same-day dispatch cutoff</div>
      </div>
      <div class="footer__stat">
        <div class="footer__stat-value" style="color: #06b6d4;">18+</div>
        <div class="footer__stat-label">Age verification required</div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/policies/terms-of-service" class="footer__legal-link">Terms</a>
        <span style="color: rgba(255,255,255,0.3);">•</span>
        <a href="/policies/privacy-policy" class="footer__legal-link">Privacy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "NicPowch"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "UK's specialist nicotine pouch retailer. Premium tobacco-free pouches for a smoke-free lifestyle."
    }
  ],
  "blocks": [
    {
      "type": "brand_link",
      "name": "Brand link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
